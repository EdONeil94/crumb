# Copy this file to .env and fill in real values — .env is gitignored.
#
# Credentials for the Playwright E2E suite (tests/). Sign-in happens once via
# tests/auth.setup.js and the resulting session is reused by every spec — see
# that file's comment for details.
#
# manage-offerings.spec.js and reservations.spec.js need this account to be
# able to open "Manage pre-orders" on whichever bakery
# tests/utils/preorders.js discovers (the first one on the Bakeries page).
# The app's ownsBakery() only allows that for the bakery's own registered
# business owner, or the hardcoded SUPER_ADMIN_UID (src/legacy-app.js) — using
# the super-admin account is the simplest way to satisfy this for any bakery.
E2E_EMAIL=
E2E_PASSWORD=

# Only needed if the app isn't served at the default http://localhost:5173/crumb/
# (e.g. testing against a deployed environment instead of the local dev server).
# E2E_BASE_URL=
