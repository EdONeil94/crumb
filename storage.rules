rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Offering photos — public read so customers can see them
    match /offerings/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bakery cover photos and profile photos — public read
    match /bakeries/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /profiles/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Item review photos — public read
    match /items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else — authenticated only
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
